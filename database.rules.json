{
  "rules": {
    ".read": false,
    ".write": false,
    "assignments": {
      ".read": "auth != null",
      "$chibi": {
        ".write": "auth != null && (auth.token.admin === true || (!data.exists() && newData.child('discordId').val() === auth.token.discordId && root.child('settings/selectionClosed').val() !== true && root.child('hiddenChibis').child($chibi).val() !== true) || (!newData.exists() && data.child('discordId').val() === auth.token.discordId))",
        ".validate": "newData.hasChildren(['discordId', 'discordUsername'])",
        "discordId": {
          ".validate": "newData.isString() && newData.val().length <= 25"
        },
        "discordUsername": {
          ".validate": "newData.isString() && newData.val().length <= 64"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 64"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "posts": {
      ".read": "auth != null",
      "$chibi": {
        "$post": {
          ".write": "auth != null && (auth.token.admin === true || root.child('assignments').child($chibi).child('discordId').val() === auth.token.discordId)",
          ".validate": "newData.hasChildren(['image', 'createdAt'])",
          "image": {
            ".validate": "newData.isString() && newData.val().beginsWith('data:image/') && newData.val().length <= 700000"
          },
          "caption": {
            ".validate": "newData.isString() && newData.val().length <= 150"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && newData.val() <= now + 60000"
          },
          "likes": {
            "$uid": {
              ".write": "auth != null && auth.token.discordId === $uid",
              ".validate": "newData.val() === true"
            }
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "profiles": {
      ".read": "auth != null",
      "$chibi": {
        ".write": "auth != null && (auth.token.admin === true || root.child('assignments').child($chibi).child('discordId').val() === auth.token.discordId)",
        "bio": {
          ".validate": "newData.isString() && newData.val().length <= 300"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "chat": {
      ".read": "auth != null",
      ".indexOn": [
        "createdAt"
      ],
      "$msg": {
        ".write": "auth != null && (auth.token.admin === true || (!data.exists() && newData.child('discordId').val() === auth.token.discordId) || (data.child('discordId').val() === auth.token.discordId && !newData.exists()))",
        ".validate": "newData.hasChildren(['text', 'discordId', 'createdAt'])",
        "text": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 1000"
        },
        "discordId": {
          ".validate": "newData.isString()"
        },
        "discordUsername": {
          ".validate": "newData.isString() && newData.val().length <= 64"
        },
        "chibiId": {
          ".validate": "newData.isString() && newData.val().length <= 64"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() <= now + 60000"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "coop": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (auth.token.discordId === $uid || (auth.token.admin === true && !newData.exists()))",
        ".validate": "newData.hasChildren(['updatedAt'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 64"
        },
        "progress": {
          ".validate": "newData.isString() && newData.val().length <= 4000"
        },
        "version": {
          ".validate": "newData.isString() && newData.val().length <= 16"
        },
        "bonusXp": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000"
        },
        "updatedAt": {
          ".validate": "newData.isNumber() && newData.val() <= now + 60000"
        },
        "unlocked": {
          "$ach": {
            ".validate": "$ach.length <= 32 && newData.isString() && newData.val().length <= 10"
          }
        },
        "music": {
          "together": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000"
          },
          "top": {
            "$vid": {
              ".validate": "$vid.length <= 16 && newData.hasChildren(['t', 'm'])",
              "t": {
                ".validate": "newData.isString() && newData.val().length <= 200"
              },
              "m": {
                ".validate": "newData.isNumber() && newData.val() >= 0"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "$other": {
            ".validate": false
          }
        },
        "friends": {
          "$fid": {
            ".validate": "$fid.length <= 25",
            "n": {
              ".validate": "newData.isString() && newData.val().length <= 64"
            },
            "p": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "l": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "missions": {
      ".read": "auth != null",
      "$day": {
        "$uid": {
          ".write": "auth != null && (auth.token.discordId === $uid || (auth.token.admin === true && !newData.exists()))",
          ".validate": "$day.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && newData.hasChildren(['score', 'updatedAt'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 64"
          },
          "score": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
          },
          "kills": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
          },
          "battles": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
          },
          "quests": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3"
          },
          "start": {
            ".validate": "newData.isNumber() && newData.val() <= now + 60000"
          },
          "updatedAt": {
            ".validate": "newData.isNumber() && newData.val() <= now + 60000"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "jam": {
      "$host": {
        ".read": "auth != null && (auth.token.discordId === $host || data.child('guest').val() === auth.token.discordId)",
        ".write": "auth != null && (auth.token.discordId === $host || (data.child('guest').val() === auth.token.discordId && newData.child('guest').val() === auth.token.discordId && newData.child('host').val() === $host))",
        ".validate": "newData.hasChildren(['host', 'guest', 'rev']) && newData.child('host').val() === $host",
        "host": {
          ".validate": "newData.isString()"
        },
        "guest": {
          ".validate": "newData.isString() && newData.val().length <= 25"
        },
        "rev": {
          ".validate": "newData.isNumber()"
        },
        "w": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "updatedAt": {
          ".validate": "newData.isNumber() && newData.val() <= now + 60000"
        },
        "cur": {
          "id": {
            ".validate": "newData.isString() && newData.val().length <= 16"
          },
          "title": {
            ".validate": "newData.isString() && newData.val().length <= 200"
          },
          "by": {
            ".validate": "newData.isString() && newData.val().length <= 64"
          },
          "key": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "paused": {
            ".validate": "newData.isBoolean()"
          },
          "pos": {
            ".validate": "newData.isNumber()"
          },
          "start": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        },
        "queue": {
          "$key": {
            ".validate": "$key.length <= 40 && newData.hasChildren(['id'])",
            "id": {
              ".validate": "newData.isString() && newData.val().length <= 16"
            },
            "title": {
              ".validate": "newData.isString() && newData.val().length <= 200"
            },
            "by": {
              ".validate": "newData.isString() && newData.val().length <= 64"
            },
            "at": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "clock": {
          "$uid": {
            ".validate": "$uid === auth.token.discordId && newData.isNumber() && newData.val() <= now + 60000"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "library": {
      "$uid": {
        ".read": "auth != null && auth.token.discordId === $uid",
        ".write": "auth != null && (auth.token.discordId === $uid || (auth.token.admin === true && !newData.exists()))",
        "updatedAt": {
          ".validate": "newData.isNumber() && newData.val() <= now + 60000"
        },
        "lists": {
          "$key": {
            ".validate": "$key.length <= 80 && newData.hasChildren(['n', 'k'])",
            "n": {
              ".validate": "newData.isString() && newData.val().length <= 200"
            },
            "k": {
              ".validate": "newData.val() === 'yt' || newData.val() === 'sp'"
            },
            "u": {
              ".validate": "newData.isNumber() && newData.val() <= now + 60000"
            },
            "t": {
              "$i": {
                ".validate": "$i.length <= 4 && newData.isString() && newData.val().length <= 260"
              }
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "gone": {
          "$key": {
            ".validate": "$key.length <= 80 && newData.isNumber()"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "customChibis": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.admin === true"
    },
    "hiddenChibis": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.admin === true"
    },
    "chibiOrder": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.admin === true"
    },
    "settings": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.admin === true"
    },
    "gameSaves": {
      "$uid": {
        ".read": "auth != null && auth.token.discordId === $uid",
        ".write": "auth != null && auth.token.discordId === $uid",
        ".validate": "newData.hasChildren(['version','rev','initialSource','profileJson','client','updatedAt']) && ((!data.exists() && newData.child('rev').val() === 1 && newData.child('initialSource').val() === 'mobile-v1') || (data.exists() && newData.child('rev').val() === data.child('rev').val() + 1 && newData.child('initialSource').val() === data.child('initialSource').val()))",
        "version": {
          ".validate": "newData.val() === 1"
        },
        "rev": {
          ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() % 1 === 0"
        },
        "initialSource": {
          ".validate": "newData.val() === 'mobile-v1'"
        },
        "profileJson": {
          ".validate": "newData.isString() && newData.val().length <= 60000"
        },
        "client": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "updatedAt": {
          ".validate": "newData.isNumber() && newData.val() <= now + 60000"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "mobileLeaderboard": {
      ".read": "auth != null",
      ".indexOn": [
        "bestFloor"
      ],
      "$uid": {
        ".write": "auth != null && auth.token.discordId === $uid",
        ".validate": "newData.hasChildren(['name','participated','bestFloor','updatedAt']) && newData.child('participated').val() === true && (!data.exists() || newData.child('bestFloor').val() >= data.child('bestFloor').val())",
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 64"
        },
        "participated": {
          ".validate": "newData.val() === true"
        },
        "bestFloor": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100 && newData.val() % 1 === 0"
        },
        "updatedAt": {
          ".validate": "newData.isNumber() && newData.val() <= now + 60000"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "socialProfiles": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.token.discordId === $uid",
        ".validate": "newData.hasChildren(['uid','name','bestFloor','rebirths','updatedAt']) && newData.child('uid').val() === $uid && newData.child('name').isString() && newData.child('name').val().length > 0 && newData.child('name').val().length <= 64 && newData.child('bestFloor').isNumber() && newData.child('bestFloor').val() >= 0 && newData.child('bestFloor').val() <= 100 && newData.child('rebirths').isNumber() && newData.child('rebirths').val() >= 0 && newData.child('rebirths').val() <= 1000 && newData.child('updatedAt').isNumber()"
      }
    },
    "chatPublicKeys": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.token.discordId === $uid",
        ".validate": "newData.hasChildren(['publicKey','updatedAt']) && newData.child('publicKey').child('kty').val() === 'EC' && newData.child('publicKey').child('crv').val() === 'P-256' && newData.child('updatedAt').isNumber()"
      }
    },
    "chatGroups": {
      "$group": {
        ".read": "auth != null && data.child('members').child(auth.token.discordId).val() === true",
        ".write": "auth != null && !data.exists() && newData.child('createdBy').val() === auth.token.discordId",
        ".validate": "newData.hasChildren(['id','name','createdBy','createdAt','members','packets']) && newData.child('id').val() === $group && newData.child('name').isString() && newData.child('name').val().length > 0 && newData.child('name').val().length <= 48 && newData.child('createdBy').val() === auth.token.discordId && newData.child('members').child(auth.token.discordId).val() === true && newData.child('createdAt').isNumber() && newData.child('members').hasChild(auth.token.discordId) && newData.child('packets').hasChild(auth.token.discordId)"
      }
    },
    "chatMembership": {
      "$uid": {
        ".read": "auth != null && auth.token.discordId === $uid",
        "$group": {
          ".write": "auth != null && !data.exists() && newData.val() === true && root.child('chatGroups').child($group).child('createdBy').val() === auth.token.discordId && root.child('chatGroups').child($group).child('members').child($uid).val() === true",
          ".validate": "newData.val() === true"
        }
      }
    },
    "chatMessages": {
      "$group": {
        ".read": "auth != null && root.child('chatGroups').child($group).child('members').child(auth.token.discordId).val() === true",
        "$message": {
          ".write": "auth != null && root.child('chatGroups').child($group).child('members').child(auth.token.discordId).val() === true && !data.exists() && newData.child('sender').val() === auth.token.discordId",
          ".validate": "newData.hasChildren(['sender','senderName','iv','ciphertext','createdAt']) && newData.child('senderName').isString() && newData.child('senderName').val().length <= 64 && newData.child('iv').isString() && newData.child('iv').val().length === 16 && newData.child('ciphertext').isString() && newData.child('ciphertext').val().length >= 24 && newData.child('ciphertext').val().length <= 6000 && newData.child('createdAt').isNumber()"
        }
      }
    },
    "factions": {
      ".read": "auth != null",
      "$faction": {
        ".write": "auth != null && !data.exists() && newData.child('leader').val() === auth.token.discordId",
        ".validate": "newData.hasChildren(['id','name','leader','createdAt','members']) && newData.child('id').val() === $faction && newData.child('name').isString() && newData.child('name').val().length >= 3 && newData.child('name').val().length <= 32 && newData.child('leader').isString() && newData.child('members').child(newData.child('leader').val()).exists()",
        "members": {
          "$uid": {
            ".write": "auth != null && auth.token.discordId === $uid && root.child('factions').child($faction).exists()",
            ".validate": "newData.hasChildren(['uid','name','joinedAt']) && newData.child('uid').val() === $uid && newData.child('name').isString() && newData.child('name').val().length > 0 && newData.child('name').val().length <= 64 && newData.child('joinedAt').isNumber()"
          }
        }
      }
    },
    "factionMembership": {
      "$uid": {
        ".read": "auth != null && auth.token.discordId === $uid",
        ".write": "auth != null && auth.token.discordId === $uid",
        ".validate": "!newData.exists() || (newData.hasChildren(['id','name']) && root.child('factions').child(newData.child('id').val()).exists() && root.child('factions').child(newData.child('id').val()).child('members').child($uid).exists())"
      }
    },
    "friendRequests": {
      "$to": {
        ".read": "auth != null && auth.token.discordId === $to",
        "$from": {
          ".write": "auth != null && (auth.token.discordId === $from || (auth.token.discordId === $to && !newData.exists()))",
          ".validate": "!newData.exists() || (newData.hasChildren(['uid','name','createdAt']) && newData.child('uid').val() === $from && newData.child('name').isString() && newData.child('name').val().length > 0 && newData.child('name').val().length <= 64 && newData.child('createdAt').isNumber())"
        }
      }
    },
    "friends": {
      "$uid": {
        ".read": "auth != null && auth.token.discordId === $uid",
        "$other": {
          ".write": "auth != null && (auth.token.discordId === $uid || auth.token.discordId === $other)",
          ".validate": "!newData.exists() || (newData.hasChildren(['uid','name','since']) && newData.child('uid').val() === $other && newData.child('name').isString() && newData.child('name').val().length > 0 && newData.child('name').val().length <= 64 && newData.child('since').isNumber())"
        }
      }
    },
    "pvpInvites": {
      "$to": {
        ".read": "auth != null && auth.token.discordId === $to",
        "$from": {
          ".write": "auth != null && (auth.token.discordId === $from || (auth.token.discordId === $to && !newData.exists()))",
          ".validate": "!newData.exists() || (newData.hasChildren(['uid','name','rating','team','createdAt']) && newData.child('uid').val() === $from && newData.child('name').isString() && newData.child('name').val().length > 0 && newData.child('name').val().length <= 64 && newData.child('rating').isNumber() && newData.child('rating').val() >= 100 && newData.child('rating').val() <= 5000 && newData.child('team').hasChildren(['0','1']) && !newData.child('team').child('2').exists() && newData.child('createdAt').isNumber())"
        }
      }
    },
    "pvpQueue": {
      "$mode": {
        ".read": "auth != null && ($mode === 'casual' || $mode === 'ranked')",
        "$uid": {
          ".write": "auth != null && auth.token.discordId === $uid",
          ".validate": "!newData.exists() || (newData.hasChildren(['uid','name','rating','team','joinedAt']) && newData.child('uid').val() === $uid && newData.child('name').isString() && newData.child('name').val().length <= 64 && newData.child('rating').isNumber() && newData.child('rating').val() >= 100 && newData.child('rating').val() <= 5000 && newData.child('team').hasChildren(['0','1']) && !newData.child('team').child('2').exists() && newData.child('joinedAt').isNumber())"
        }
      }
    },
    "pvpPairLocks": {
      "$mode": {
        "$pair": {
          ".read": "auth != null",
          ".write": "auth != null",
          ".validate": "newData.hasChildren(['id','expiresAt']) && newData.child('id').isString() && newData.child('id').val().length <= 100 && newData.child('expiresAt').isNumber() && newData.child('expiresAt').val() <= now + 60000"
        }
      }
    },
    "pvpActive": {
      "$uid": {
        ".read": "auth != null && auth.token.discordId === $uid",
        ".write": "auth != null && (auth.token.discordId === $uid || (newData.isString() && root.child('pvpMatches').child(newData.val()).child('host').val() === auth.token.discordId && root.child('pvpMatches').child(newData.val()).child('guest').val() === $uid))",
        ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 100)"
      }
    },
    "pvpMatches": {
      "$match": {
        ".read": "auth != null && (data.child('host').val() === auth.token.discordId || data.child('guest').val() === auth.token.discordId)",
        ".write": "auth != null && ((data.exists() && (data.child('host').val() === auth.token.discordId || data.child('guest').val() === auth.token.discordId)) || (!data.exists() && (newData.child('host').val() === auth.token.discordId || newData.child('guest').val() === auth.token.discordId)))",
        ".validate": "newData.hasChildren(['version','mode','status','turn','host','guest','players','updatedAt']) && newData.child('version').val() === 1 && (newData.child('mode').val() === 'casual' || newData.child('mode').val() === 'ranked') && (newData.child('status').val() === 'active' || newData.child('status').val() === 'finished') && newData.child('turn').isNumber() && newData.child('turn').val() >= 1 && newData.child('turn').val() <= 200 && newData.child('host').isString() && newData.child('guest').isString() && newData.child('host').val() !== newData.child('guest').val() && newData.child('updatedAt').isNumber()"
      }
    },
    "pvpRatings": {
      ".read": "auth != null",
      ".indexOn": ["rating"],
      "$uid": {
        ".write": "auth != null && auth.token.discordId === $uid",
        ".validate": "newData.hasChildren(['name','rating','wins','losses','draws','games','updatedAt']) && newData.child('name').isString() && newData.child('name').val().length <= 64 && newData.child('rating').isNumber() && newData.child('rating').val() >= 100 && newData.child('rating').val() <= 5000 && newData.child('wins').isNumber() && newData.child('losses').isNumber() && newData.child('draws').isNumber() && newData.child('games').isNumber() && newData.child('updatedAt').isNumber() && ((!data.exists() && newData.child('rating').val() === 1000 && newData.child('games').val() === 0) || (data.exists() && newData.child('games').val() === data.child('games').val() + 1 && newData.child('rating').val() >= data.child('rating').val() - 32 && newData.child('rating').val() <= data.child('rating').val() + 32))"
      }
    },
    "wishHistory": {
      "$uid": {
        ".read": "auth != null && auth.token.discordId === $uid",
        "$event": {
          ".write": "auth != null && auth.token.discordId === $uid && !data.exists() && newData.exists()",
          ".validate": "newData.hasChildren([\"id\",\"at\",\"portal\",\"count\",\"freeUsed\",\"coinsPaid\",\"coinsBefore\",\"coinsAfter\",\"freeBefore\",\"freeAfter\",\"first\",\"last\",\"drawsJson\"])",
          "id": {
            ".validate": "newData.isString() && newData.val() === $event && newData.val().length <= 100"
          },
          "at": {
            ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now + 60000"
          },
          "portal": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "count": {
            ".validate": "newData.val() === 1 || newData.val() === 10"
          },
          "freeUsed": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() % 1 === 0"
          },
          "coinsPaid": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() % 1 === 0"
          },
          "coinsBefore": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() % 1 === 0"
          },
          "coinsAfter": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() % 1 === 0"
          },
          "freeBefore": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() % 1 === 0"
          },
          "freeAfter": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() % 1 === 0"
          },
          "first": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() % 1 === 0"
          },
          "last": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() % 1 === 0"
          },
          "drawsJson": {
            ".validate": "newData.isString() && newData.val().length <= 5000"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}
