{
  "name": "TWEWY Co-op",
  "short_name": "TWEWY Co-op",
  "description": "Le launcher TWEWY Co-op sur ton téléphone : profil, classement, amis, musique et communauté.",
  "lang": "fr",
  "start_url": "./app.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#141217",
  "theme_color": "#141217",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Musique", "url": "./musique.html", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Classement", "url": "./classement.html", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Amis", "url": "./amis.html", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
