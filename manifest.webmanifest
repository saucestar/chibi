{
  "name": "TWEWY Co-op",
  "short_name": "TWEWY Co-op",
  "description": "Le launcher TWEWY Co-op sur ton téléphone : profil, classement, amis, musique et communauté.",
  "lang": "fr",
  "start_url": "./app.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#e6e0d1",
  "theme_color": "#1f1d23",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Musique", "url": "./app.html#music", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Classement", "url": "./app.html#board", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Amis", "url": "./app.html#friends", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
